# Copy to .env (gitignored), fill in, then: chmod 600 .env
# Never paste these values into a chat, an issue, or a commit.
SNAPTRADE_CLIENT_ID=your-client-id-here
SNAPTRADE_CONSUMER_KEY=your-consumer-key-here
SNAPTRADE_AUTH_MODE=personal

# commercial mode only (leave blank for personal)
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET_FILE=~/.config/snaptrade-watch/user_secret

# Dry-run unless this is exactly: true
LIVE_TRADING=false
MAX_ORDER_VALUE_CAD=500
# Conservative USD->CAD rate used ONLY for the cap check
CAP_USD_CAD_RATE=1.5
LOG_FILE=./logs/snaptrade.jsonl

# optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
