# Copy to .env (gitignored), fill in, then: chmod 600 .env
# Never paste these values into a chat, an issue, or a commit.
SNAPTRADE_CLIENT_ID=your-client-id-here
SNAPTRADE_CONSUMER_KEY=your-consumer-key-here
SNAPTRADE_AUTH_MODE=personal

# commercial mode only (leave blank for personal)
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET_FILE=~/.config/snaptrade-watch/user_secret

# Dry-run unless this is exactly: true
LIVE_TRADING=false
MAX_ORDER_VALUE_CAD=500
# Conservative USD->CAD rate used ONLY for the cap check
CAP_USD_CAD_RATE=1.5
LOG_FILE=./logs/snaptrade.jsonl

# optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- screener ----
# yahoo (works in GitHub Actions) or moomoo (your computer, OpenD running)
DATA_SOURCE=yahoo
WATCHLIST=NVDA,TSLA,AMD,META,AAPL,MSFT,AMZN,GOOGL,PLTR,AVGO
# wealthsimple or moomoo: picks fee defaults. Check your real fees and override below.
ACCOUNT_PROFILE=wealthsimple
COMMISSION=
FX_FEE_PCT=
# Your max risk per trade in dollars. Ideas with a bigger max loss are marked THROW IT OUT.
MAX_RISK_PER_TRADE=
RISK_FREE_RATE=0.04
FINNHUB_API_KEY=
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
