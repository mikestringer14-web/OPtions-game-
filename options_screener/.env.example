# Copy to .env (gitignored). Never commit real values.
IBKR_HOST=127.0.0.1
# Paper ports only: 7497 (TWS paper) or 4002 (IB Gateway paper)
IBKR_PORT=4002
IBKR_CLIENT_ID=17
# Your IBKR PAPER account id (starts with DU). Only used by paper.py.
IBKR_PAPER_ACCOUNT=
# Optional historical options data (paid): massive | csv | none
HISTORICAL_OPTIONS_PROVIDER=none
MASSIVE_API_KEY=
# Optional earnings calendar (free key): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
