# Copy this file to .env and fill in real values before running the server.

# SQLite file for local/dev. For production, point this at a Postgres URL
# and switch the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

PORT=4000

# Shared secret the mobile app sends as `x-api-key` on every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=changeme-generate-a-real-secret

# --- Email (end-of-day report auto-send) ---
# Placeholder values. Nothing will send until these are real. Any SMTP
# provider works (Gmail app password, Outlook, SendGrid SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
REPORT_FROM_NAME="Canvassing Tracker"

# Google Maps (Geocoding API + Maps Static API for the PDF map snapshot).
# Get a key at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=changeme
