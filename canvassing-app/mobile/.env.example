# Copy to .env and fill in. Expo reads EXPO_PUBLIC_* vars into app code at
# build time via app.config.ts - see that file.

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_KEY=changeme-must-match-server-API_KEY

# https://console.cloud.google.com/google/maps-apis - enable "Maps SDK for iOS"
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=changeme
