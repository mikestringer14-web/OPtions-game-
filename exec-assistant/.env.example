# ---- Core ----
# Long random string. Dashboard + API login. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
EA_ADMIN_TOKEN=change-me
EA_DB_PATH=./data/assistant.db
EA_TIMEZONE=America/Toronto
# Public https URL this server is reachable at (used for Twilio signature checks)
EA_PUBLIC_BASE_URL=https://your-server.example.com
# observer | approval | autonomous | emergency
EA_MODE=approval
# Quiet hours (local time). Critical alerts still go through.
EA_QUIET_START=23:00
EA_QUIET_END=05:30
EA_DAILY_SPEND_LIMIT_USD=3.00

# ---- Owner identity ----
EA_OWNER_NAME=YourFirstName
# Your real cell in E.164, e.g. +1905XXXXXXX. Used to recognise YOU texting the assistant.
EA_OWNER_PHONE=
# PIN you must put at the start of any command texted to the assistant
EA_OWNER_PIN=
# Comma list of private names/orgs that should always be treated as sensitive (never auto-sent)
EA_SENSITIVE_KEYWORDS=

# ---- LLM (optional; rules-based fallback works without it) ----
# none | anthropic | openai
EA_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
EA_ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
EA_OPENAI_MODEL=gpt-4o-mini

# ---- Notifications ----
# ntfy.sh push to iPhone (free). Pick a long unguessable topic name.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the assistant texts FROM
TWILIO_FROM_NUMBER=

# ---- ElevenLabs post-call webhook ----
ELEVENLABS_WEBHOOK_SECRET=

# ---- iPhone Shortcuts SMS bridge ----
EA_IOS_BRIDGE_TOKEN=

# ---- Google (Gmail + Calendar) OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
